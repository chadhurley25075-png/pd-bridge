# ---------------------------------------------------------------------------
# pd-bridge, plain-attention models over RDMA (PD_MODE=kv). Copy next to config.env and source both:
#   cp config.rdma.example.env config.rdma.env && $EDITOR config.rdma.env && source config.env config.rdma.env
# Addresses below are examples; nothing here has a working default. See docs/RDMA.md.
# ---------------------------------------------------------------------------
# Prefill box: the vLLM venv, the model, and the served name the front door asks for.
export PD_VLLM_BIN="$HOME/vllm-env/bin/vllm"
export PD_VLLM_PYTHON="$HOME/vllm-env/bin/python"
export PD_KV_MODEL="$HOME/models/Qwen3-32B"
export PD_SPARK_MODEL="qwen3-32b"
export PD_KV_HOST="10.0.0.11"                 # address vLLM binds (reachable from the Mac)
# RDMA link. Control TCP uses any shared IP link; bulk bytes use RoCEv2.
export PD_RDMA_RECV_BIND="10.0.0.20"          # the Mac's control address; `pd_rdma recvd` listens here
export PD_RDMA_STREAM_PORT="18516"
export PD_RDMA_DEV="rocep1s0f1"               # prefill-side RDMA device cabled to the Mac (ibv_devices)
export PD_RDMA_GID_INDEX="3"                  # its RoCEv2 GID — check `show_gids`, it is NOT always 3
export PD_RDMA_ARENA_MIB="128"                # must hold one decoder block file (Qwen3-32B: 64 MiB)
# Decode side, kv mode.
export PD_MODE="kv"
export PD_TRANSPORT="rdma4"
export PD_OMLX_STAGE="1"
export PD_OMLX_RESERVE_TOKENS="1024"
export PD_MIN_TOKENS="2048"
export PD_MIN_TAIL="2048"
