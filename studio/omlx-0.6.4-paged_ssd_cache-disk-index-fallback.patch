+    def _pd_index_from_disk(self, block_hash: bytes):
+        """Compass 2026-09-06 (heterogeneous P/D): the startup scan is the only
+        indexer upstream, so blocks written by an external producer (the Spark
+        prefill bridge) were invisible until restart. On an index miss, look for
+        the file on disk, validate it with the same reader + compatibility check
+        the scan uses, and index it. Cheap (one stat) on a true miss."""
+        try:
+            if self._cache_dir is None or not isinstance(block_hash, (bytes, bytearray)):
+                return None
+            hex_hash = bytes(block_hash).hex()
+            file_path = self._cache_dir / hex_hash[0] / f"{hex_hash}.safetensors"
+            if not file_path.is_file():
+                return None
+            metadata = self._read_file_metadata(file_path)
+            if metadata is None or not self._is_compatible_block(metadata):
+                return None
+            self._index.add(metadata)
+            logger.info(f"[pd] indexed externally written block {hex_hash[:16]}… from disk")
+            return metadata
+        except Exception as e:  # never let the fallback break a lookup
+            logger.warning(f"[pd] disk fallback failed for block: {e}")
+            return None
 
