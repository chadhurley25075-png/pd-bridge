+    def _pd_index_from_disk(self, block_hash: bytes):
+        """pd-bridge: the startup scan is the only indexer upstream, so blocks written by an
+        external producer (the Spark prefill bridge) were invisible until restart. On an index
+        miss, look for the file on disk, validate it, verify its identity, and index it."""
+        try:
+            if self._cache_dir is None or not isinstance(block_hash, (bytes, bytearray)):
+                return None
+            hex_hash = bytes(block_hash).hex()
+            file_path = self._cache_dir / hex_hash[0] / f"{hex_hash}.safetensors"
+            if not file_path.is_file():
+                return None
+            metadata = self._read_file_metadata(file_path)
+            if metadata is None or not self._is_compatible_block(metadata):
+                return None
+            # The startup scan derives a block's identity from its CONTENT. This fallback
+            # reaches the file by PATH, so it must re-establish that identity before trusting
+            # it: a stale, truncated, or misnamed file at the expected path would otherwise
+            # be indexed as the requested block and served as correct cache. Reported by an
+            # external reviewer 2026-09-08. Without this the failure is silent and produces
+            # fluent, wrong output.
+            if bytes(metadata.block_hash) != bytes(block_hash):
+                logger.warning(
+                    "[pd] refusing block at %s: metadata.block_hash %s != requested %s"
+                    % (file_path.name, bytes(metadata.block_hash).hex()[:16], hex_hash[:16])
+                )
+                return None
+            self._index.add(metadata)
+            logger.info("[pd] indexed externally written block %s from disk" % hex_hash[:16])
+            return metadata
+        except Exception as e:  # never let the fallback break a lookup
+            logger.warning("[pd] disk fallback failed for block: %s" % e)
+            return None
+
