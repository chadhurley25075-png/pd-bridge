# ---------------------------------------------------------------------------
# pd-bridge configuration. Copy to config.env and edit for your two machines.
#   source config.env
# Nothing here has a working default: the bridge refuses to guess at addresses.
# ---------------------------------------------------------------------------

# === PREFILL SIDE (the NVIDIA machines running vLLM) ======================
# OpenAI-compatible endpoint of the vLLM head node.
export PD_SPARK="http://10.0.0.11:8000"
# SSH target for the head node (used to pull captures; key auth required).
export PD_SPARK_SSH="user@10.0.0.11"
# Where the capture hook writes on the head node (must match PD_CAPTURE_DIR
# inside the container mount in pd-launch-v3.sh).
export PD_SPARK_CAPDIR="$HOME/pd_capture"

# Set on the prefill nodes themselves:
# Interconnect address of the TP head, used as vLLM --master-addr.
export PD_HEAD_IP="10.0.1.10"   # your head node's interconnect (RDMA) address — check `show_gids`
# HuggingFace cache holding deepseek-ai/DeepSeek-V4-Flash (FP8). May differ
# per node if one node stages weights on external storage.
export HF_DIR="$HOME/.cache/huggingface"
# Directory holding pd_pool_torch.py + the exported projection weights.
export PD_V3="$HOME/pd_v3"
# Local capture staging directory on the head node.
export PD_CAPTURE_DIR="$HOME/pd_capture"
# NIC / RDMA settings for your fabric. NCCL_IB_GID_INDEX is fabric-specific:
# check `show_gids` — it is NOT always 3.
export PD_NCCL_IB_HCA="rocep1s0f0"
export PD_NCCL_IB_GID_INDEX="5"
export PD_NCCL_IFNAME="enp1s0f0np0"
# Container image providing vLLM + the DeepSeek-V4 plugin.
export PD_VLLM_IMAGE="aidendle94/sparkrun-vllm-ds4-gb10:production-ready"

# === DECODE SIDE (the Apple Silicon machine running oMLX) =================
# MLX model directory (stock MXFP4 build).
export PD_MODEL="$HOME/models/DV4-Flash-MXFP4-MLX"
# Model id as oMLX serves it.
export PD_MODEL_NAME="DV4-Flash-MXFP4-MLX"
# The local oMLX server.
export PD_OMLX="http://127.0.0.1:8011"
# oMLX's SSD prefix-cache directory.
export PD_CACHE_DIR="$HOME/.omlx/cache"
# Port the bridge front door listens on.
export PD_PORT="8012"
# Python interpreter inside the oMLX virtualenv.
export OMLX_PYTHON="$HOME/omlx/bin/python"
# Local staging for pulled captures.
export PD_PULL_DIR="$HOME/pd_pull"

# === BRIDGE POLICY ========================================================
# "pooled" = v3 (ship finished caches — recommended).
# "hidden" = v1/v2 (ship attention inputs, rebuild on the Mac — 36x payload).
export PD_MODE="pooled"
# Below this prompt length, don't bridge — the Mac is faster on its own.
export PD_MIN_TOKENS="4096"
# In pooled mode, bridge only when the uncached tail is at least this long.
export PD_MIN_TAIL="8192"

# === BENCHMARKING =========================================================
# Address of the bridge front door as seen from the client.
export DECODER_HOST="10.0.0.20"
